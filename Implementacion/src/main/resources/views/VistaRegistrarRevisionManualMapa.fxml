<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.grupo7.dsi.tpai.boundaries.PantallaRegistrarRevisionManual"
            prefWidth="1024" prefHeight="768"
            stylesheets="@light-theme.css">

    <VBox spacing="20" alignment="CENTER" styleClass="card-pane"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <ImageView fitWidth="960" fitHeight="620" preserveRatio="true">
            <image>
                <Image url="/views/mapaSismo.png"/>
            </image>
        </ImageView>

        <Button text="Volver"
                onAction="#handleCerrarDetalleEvento"
                styleClass="button-peligro" />
    </VBox>
</AnchorPane>