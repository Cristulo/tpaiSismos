<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.grupo7.dsi.tpai.controllers.VentanaPrincipalController"
      spacing="25" alignment="CENTER"
      prefWidth="500" prefHeight="550"
      stylesheets="@light-theme.css"
      styleClass="card-pane">
    <children>

        <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
            <image>
                <Image url="/views/logo-red-sismica.jpeg" />
            </image>
        </ImageView>

        <Label text="Gestión de Eventos Sísmicos" styleClass="titulo-principal" />

        <Button text="Registrar resultado de revisión manual"
                fx:id="btnRegistrarRevision"
                onAction="#handleRegistrarRevision"
                styleClass="button-accion"
                prefWidth="320" />

        <Button text="Cerrar Orden de Inspección"
                fx:id="btnConsultarEventos"
                prefWidth="320" />

        <Button text="Generar reporte"
                fx:id="btnGenerarReporte"
                prefWidth="320" />

        <Button text="Salir"
                fx:id="btnSalir"
                onAction="#handleSalir"
                styleClass="button-peligro"
                prefWidth="320" />
    </children>
</VBox>