<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.grupo7.dsi.tpai.boundaries.PantallaRegistrarRevisionManual"
            prefWidth="800" prefHeight="600"
            stylesheets="@light-theme.css">

    <VBox spacing="15" styleClass="card-pane"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="🛠 Modificar Datos del Evento Sísmico"
               styleClass="titulo-seccion" />

        <Label text="Magnitud" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Número:" minWidth="100"/>
            <TextField fx:id="txtMagnitudNumero" promptText="Ej: 5.6" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Descripción:" minWidth="100"/>
            <TextField fx:id="txtMagnitudDescripcion" promptText="Ej: Moderado" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="Alcance del Sismo" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Nombre:" minWidth="100"/>
            <TextField fx:id="txtAlcanceNombre" promptText="Ej: Local" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Descripción:" minWidth="100"/>
            <TextField fx:id="txtAlcanceDescripcion" promptText="Ej: Se sintió en zona urbana" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label text="Origen de Generación" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Nombre:" minWidth="100"/>
            <TextField fx:id="txtOrigenNombre" promptText="Ej: Tectónico" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Descripción:" minWidth="100"/>
            <TextField fx:id="txtOrigenDescripcion" promptText="Ej: Movimiento de placas" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Continuar sin modificar"
                    onAction="#tomarSeleccionModificacionDeDatos" />
            <Button text="Guardar cambios"
                    styleClass="button-principal"/>
        </HBox>
    </VBox>
</AnchorPane>