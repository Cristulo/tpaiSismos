<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.grupo7.dsi.tpai.boundaries.PantallaRegistrarRevisionManual"
            prefWidth="1200" prefHeight="800"
            stylesheets="@light-theme.css"
            styleClass="card-pane">

    <TableView fx:id="tablaEventos"
               AnchorPane.topAnchor="20"    AnchorPane.bottomAnchor="80"
               AnchorPane.leftAnchor="20"   AnchorPane.rightAnchor="20">

        <columns>
            <TableColumn fx:id="colSeleccionar"
                         text="Seleccionar" prefWidth="120"
                         editable="true"
                         sortable="false"/>
            <TableColumn fx:id="colFechaHora"
                         text="Fecha y Hora" prefWidth="250"
                         sortable="false"/>
            <TableColumn fx:id="colMagnitud"
                         text="Magnitud" prefWidth="180"
                         sortable="false"/>
            <TableColumn fx:id="colLugarOrigen"
                         text="Lugar Origen" prefWidth="550"
                         sortable="false"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button fx:id="btnContinuar"
            text="Continuar"
            onAction="#tomarSeleccionEventoSismico"
            styleClass="button-principal"
            AnchorPane.bottomAnchor="20"
            AnchorPane.rightAnchor="20"
            prefWidth="120" />
</AnchorPane>